{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xygeni.io/schemas/secrets/xygeni_secret_descriptor.schema.json",
  "title": "Xygeni Secret Detector Descriptor",
  "description": "Schema for Xygeni secret detector YAML configuration files",
  "type": "object",
  "required": ["id", "type"],
  "definitions": {
    "extended_boolean": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "enum": ["yes", "no", "true", "false"] }
      ],
      "description": "Boolean value that accepts true/false or yes/no strings"
    },
    "regexConfig": {
      "type": "object",
      "description": "Regular expression configuration",
      "required": ["pattern"],
      "properties": {
        "pattern": {
          "type": "string",
          "description": "The regular expression pattern"
        },
        "exact": {
          "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
          "description": "If true, requires full match; otherwise partial match",
          "default": false
        },
        "ignorecase": {
          "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
          "description": "If true, pattern matching is case-insensitive",
          "default": false
        },
        "secretGroup": {
          "type": "integer",
          "description": "Capturing group for the secret value (0 = matched string)",
          "default": 0
        },
        "keyGroup": {
          "type": "integer",
          "description": "Capturing group for the key (-1 = key from parser)",
          "default": -1
        },
        "secretIdGroup": {
          "type": "integer",
          "description": "Capturing group for secret ID (e.g., access key ID)"
        },
        "secretUrlGroup": {
          "type": "integer",
          "description": "Capturing group for secret URL"
        }
      },
      "additionalProperties": false
    },
    "standardDetectorConfig": {
      "type": "object",
      "description": "Configuration for pattern matching on key/value",
      "properties": {
        "regex": {
          "$ref": "#/definitions/regexConfig"
        },
        "minlen": {
          "type": "integer",
          "description": "Minimum length of the matched value",
          "minimum": 0
        },
        "minEntropy": {
          "type": "number",
          "description": "Minimum Shannon entropy [0.0-8.0] bits per byte",
          "minimum": 0,
          "maximum": 8
        },
        "base64": {
          "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
          "description": "Check if value is base64-encoded"
        },
        "ascii": {
          "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
          "description": "Check if value contains printable ASCII characters"
        },
        "uri": {
          "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
          "description": "Check if value starts with URL pattern"
        },
        "uuid4": {
          "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
          "description": "Check if value matches UUID v4 pattern"
        },
        "ignore": {
          "type": "array",
          "description": "Patterns to ignore (reduce false positives)",
          "items": {
            "type": "string"
          }
        },
        "toCheck": {
          "type": "string",
          "description": "What to check",
          "enum": ["key", "value", "key_value", "line"]
        }
      },
      "additionalProperties": false
    },
    "verifierConfig": {
      "type": "object",
      "description": "Configuration for secret verification",
      "required": ["className"],
      "properties": {
        "className": {
          "type": "string",
          "description": "Fully-qualified Java class name of the verifier"
        },
        "enabled": {
          "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
          "description": "Whether the verifier is enabled",
          "default": true
        },
        "action": {
          "type": "string",
          "description": "Action to perform based on verification result",
          "enum": [
            "do_nothing",
            "increase_severity_when_verified",
            "decrease_severity_when_not_verified",
            "ignore_when_not_verified",
            "set_info_when_not_verified"
          ],
          "default": "do_nothing"
        },
        "properties": {
          "type": "object",
          "description": "Verifier-specific properties",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "remediationInput": {
      "type": "object",
      "description": "Input parameter for remediation playbook",
      "properties": {
        "kind": {
          "type": "string",
          "description": "Type of the input",
          "enum": ["string", "integer", "bool", "real", "list", "map"],
          "default": "string"
        },
        "default": {
          "description": "Default value for the input"
        },
        "min": {
          "type": "number",
          "description": "Minimum value (for numeric types)"
        },
        "max": {
          "type": "number",
          "description": "Maximum value (for numeric types)"
        },
        "options": {
          "type": "array",
          "description": "Available options (for string/list types)",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "Documentation for this input"
        }
      },
      "additionalProperties": false
    },
    "remediationConfig": {
      "type": "object",
      "description": "Configuration for automatic remediation",
      "properties": {
        "enabled": {
          "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
          "description": "Whether remediation is enabled",
          "default": true
        },
        "on": {
          "type": "string",
          "description": "Where remediation runs (comma-separated: scan, guardrail, backend, workflow)",
          "default": "scan, guardrail"
        },
        "description": {
          "type": "string",
          "description": "What the remediation does"
        },
        "inputs": {
          "type": "object",
          "description": "Input parameters for the playbook",
          "additionalProperties": {
            "$ref": "#/definitions/remediationInput"
          }
        },
        "action": {
          "type": "string",
          "description": "Action on issue when remediation succeeds",
          "enum": ["decrease_severity", "set_info", "discard", "do_nothing"],
          "default": "set_info"
        },
        "playbook": {
          "type": "string",
          "description": "Remediation playbook script"
        }
      },
      "additionalProperties": false
    },
    "patternConfig": {
      "type": "object",
      "description": "Additional pattern configuration for multi-pattern detectors",
      "properties": {
        "id": {
          "type": "string",
          "description": "Pattern identifier"
        },
        "key": {
          "$ref": "#/definitions/standardDetectorConfig"
        },
        "value": {
          "$ref": "#/definitions/standardDetectorConfig"
        },
        "verifier": {
          "$ref": "#/definitions/verifierConfig"
        }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the detector",
      "examples": ["aws_secret", "github_token", "private_key"]
    },
    "enabled": {
      "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
      "description": "Whether the detector is enabled",
      "default": true
    },
    "type": {
      "type": "string",
      "description": "Secret type category",
      "enum": [
        "amazon_mws_token",
        "amqp_credentials",
        "alicloud_id",
        "alicloud_secret",
        "artifactory_apikey",
        "artifactory_token",
        "artifactory_pwd",
        "aws_id",
        "aws_secret",
        "aws_token",
        "azure_pat",
        "azure_management_certificate",
        "azure_storage_key",
        "apikey",
        "base64",
        "basic_auth",
        "basic_auth_url",
        "client_id",
        "cloudant_credentials",
        "cloudflare_credential",
        "cloudafare_credential",
        "comment",
        "credit_card",
        "data_storage_secret",
        "django_secret_key",
        "dockercfg",
        "docker_swarm_join_token",
        "docker_swarm_unlock_key",
        "github_token",
        "gitlab_token",
        "google_apikey",
        "google_cloud_key",
        "htpasswd",
        "ibm_cloud_key",
        "ibm_cos_hmac_key",
        "jwt",
        "kubernetes_cert",
        "npm_token",
        "ldap_credentials",
        "oauth_token",
        "pip",
        "private_key",
        "pypi_key",
        "pypirc",
        "rails_master_key",
        "rails_secret_key_base",
        "smtp_credentials",
        "slack_token",
        "stripe_secret",
        "stripe_webhook",
        "symmetric_key",
        "tencent_cloud_keys",
        "twitter_access_key",
        "api_token",
        "access_key",
        "generic_secret",
        "password",
        "password_hash",
        "high_entropy",
        "keyword",
        "regex",
        "ssh_credentials",
        "webhook",
        "url",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what the detector finds"
    },
    "severity": {
      "type": "string",
      "description": "Default severity for detected secrets",
      "enum": ["info", "low", "high", "critical"]
    },
    "confidence": {
      "type": "string",
      "description": "Confidence level for detections",
      "enum": ["low", "medium", "high", "highest"],
      "default": "high"
    },
    "classname": {
      "type": "string",
      "description": "Java class implementing the detector (relative to com.depsdoctor.secrets.scanner.detector.impl)"
    },
    "generic": {
      "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
      "description": "If true, this is a generic detector for unknown target systems",
      "default": false
    },
    "fileTypes": {
      "type": "array",
      "description": "File types this detector applies to",
      "items": {
        "type": "string"
      }
    },
    "fileRegex": {
      "type": "string",
      "description": "Pattern for file paths this detector applies to"
    },
    "similarity": {
      "type": "number",
      "description": "Threshold [0-1] for key-value similarity (to reduce false positives)",
      "minimum": 0,
      "maximum": 1
    },
    "obfuscate": {
      "allOf": [{ "$ref": "#/definitions/extended_boolean" }],
      "description": "If false, the matched string should not be obfuscated in reports",
      "default": true
    },
    "key": {
      "$ref": "#/definitions/standardDetectorConfig",
      "description": "Pattern matching configuration for entry key"
    },
    "value": {
      "$ref": "#/definitions/standardDetectorConfig",
      "description": "Pattern matching configuration for entry value"
    },
    "secretId": {
      "$ref": "#/definitions/standardDetectorConfig",
      "description": "Pattern for matching secret identifier (e.g., access key ID)"
    },
    "secretUrl": {
      "$ref": "#/definitions/standardDetectorConfig",
      "description": "Pattern for matching associated URL"
    },
    "withEntryTags": {
      "type": "array",
      "description": "Entry tags this detector matches",
      "items": {
        "type": "string"
      }
    },
    "quickFilters": {
      "type": "array",
      "description": "Quick filter strings for pre-regex matching",
      "items": {
        "type": "string"
      }
    },
    "verifier": {
      "$ref": "#/definitions/verifierConfig",
      "description": "Configuration for secret verification"
    },
    "remediation": {
      "$ref": "#/definitions/remediationConfig",
      "description": "Configuration for automatic remediation"
    },
    "patterns": {
      "type": "array",
      "description": "Additional patterns for multi-pattern detectors",
      "items": {
        "$ref": "#/definitions/patternConfig"
      }
    },
    "defaultPolicies": {
      "type": "array",
      "description": "Security policies this detector applies to",
      "items": {
        "type": "string",
        "enum": ["Very_Strict", "Standard", "Essential"]
      }
    },
    "tag": {
      "type": "array",
      "description": "Tags for categorization",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "id": "xygeni_opaque_token",
      "enabled": true,
      "type": "apikey",
      "description": "Xygeni.io user / organization token",
      "severity": "high",
      "confidence": "high",
      "value": {
        "regex": {
          "pattern": "(xyo_|xyu_)[a-zA-Z0-9]{64}",
          "ignorecase": false,
          "exact": true
        }
      },
      "verifier": {
        "enabled": true,
        "className": "com.depsdoctor.secrets.scanner.detector.verifier.ApiVerifier",
        "action": "set_info_when_not_verified",
        "properties": {
          "host": "https://api.xygeni.io/token/self",
          "tokenPrefix": "Bearer"
        }
      },
      "remediation": {
        "enabled": true,
        "on": "scan, guardrail",
        "description": "Revokes a Xygeni.io token using the self-revoke API.",
        "playbook": "token = secret.decrypt(issue);\nrequire exists(token);\napi(\n  'https://api.xygeni.io', 'DELETE', '/token/revoke/self', \n  headers = {'Authorization': 'Bearer ' + token} \n);"
      },
      "defaultPolicies": ["Very_Strict", "Standard", "Essential"]
    },
    {
      "id": "private_key",
      "enabled": true,
      "type": "private_key",
      "description": "Private key",
      "severity": "critical",
      "confidence": "high",
      "classname": "PrivateKeyDetector",
      "defaultPolicies": ["Very_Strict", "Standard", "Essential"]
    },
    {
      "id": "azure_storage_key",
      "enabled": true,
      "type": "azure_storage_key",
      "description": "Azure Storage access key",
      "severity": "critical",
      "confidence": "high",
      "key": {
        "regex": {
          "pattern": "(?:storage)?AccountKey",
          "exact": true,
          "ignorecase": true
        }
      },
      "value": {
        "regex": {
          "pattern": "[a-zA-Z0-9+\\/=]{88}",
          "exact": true
        },
        "base64": true
      },
      "defaultPolicies": ["Very_Strict", "Standard", "Essential"]
    }
  ]
}
